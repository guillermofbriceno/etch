{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "store:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:deny-default",
    "fs:deny-write-file",
    "fs:deny-write-text-file",
    "fs:deny-write",
    "fs:deny-open",
    "fs:deny-create",
    "fs:deny-mkdir",
    "fs:deny-copy-file",
    "fs:deny-remove",
    "fs:deny-rename",
    "fs:deny-truncate",
    "fs:deny-ftruncate",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "$DOWNLOADS/**", "$DOCUMENTS/**", "$PICTURES/**", "$DESKTOP/**"]
    },
    "updater:default",
    "process:allow-restart",
    "core:tray:default",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-tooltip",
    "core:menu:default",
    "core:image:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-is-visible"
  ]
}
